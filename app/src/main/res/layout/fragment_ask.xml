<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/auth_screen_padding_horizontal"
        android:paddingTop="@dimen/auth_screen_padding_vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ask_title"
            android:textColor="@color/auth_foreground"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ask_subtitle"
            android:textColor="@color/auth_muted_foreground"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_auth_shell_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/edit_question"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_auth_input"
                android:gravity="top|start"
                android:hint="@string/ask_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="14dp"
                android:textColor="@color/auth_foreground"
                android:textColorHint="@color/auth_muted_foreground"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/auth_brand"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_input_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_auth_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/ask_send"
                android:textAllCaps="false"
                android:textColor="@color/auth_primary_foreground"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="@dimen/auth_input_radius" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/ask_suggestions_header"
            android:textColor="@color/auth_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/auth_card"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="@string/ask_suggestion_1"
            android:textAllCaps="false"
            android:textColor="@color/auth_foreground"
            android:textSize="13sp"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/auth_card"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="@string/ask_suggestion_2"
            android:textAllCaps="false"
            android:textColor="@color/auth_foreground"
            android:textSize="13sp"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/auth_card"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="@string/ask_suggestion_3"
            android:textAllCaps="false"
            android:textColor="@color/auth_foreground"
            android:textSize="13sp"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_suggestion_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/auth_card"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="@string/ask_suggestion_4"
            android:textAllCaps="false"
            android:textColor="@color/auth_foreground"
            android:textSize="13sp"
            app:cornerRadius="@dimen/auth_input_radius"
            app:strokeColor="@color/auth_input_ring"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
